{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tak848/ccgate/main/schemas/claude.schema.json",
  "properties": {
    "provider": {
      "properties": {
        "name": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "base_url": {
          "type": "string"
        },
        "auth": {
          "oneOf": [
            {
              "properties": {
                "type": {
                  "type": "string",
                  "const": "exec"
                },
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Shell command run via `/bin/sh -c`. Stdout is the credential."
                },
                "refresh_margin": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$",
                  "description": "Cache early-refresh threshold + minimum remaining TTL guard for fresh credentials. Parsed via time.ParseDuration (e.g. \"30s\", \"5m\")."
                },
                "timeout": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$",
                  "description": "Hot-path upper bound for one helper invocation. Parsed via time.ParseDuration (e.g. \"30s\", \"5m\")."
                },
                "cache_key": {
                  "type": "string",
                  "description": "Secret-free salt for separating cache files across env / profile contexts. Supports ${VAR} env expansion."
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "type",
                "command"
              ]
            },
            {
              "properties": {
                "type": {
                  "type": "string",
                  "const": "file"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Absolute or ~/-prefixed file path. Read every hook fire."
                },
                "refresh_margin": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$",
                  "description": "Minimum remaining TTL guard for file output. Parsed via time.ParseDuration (e.g. \"30s\", \"5m\")."
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "type",
                "path"
              ]
            }
          ],
          "title": "auth"
        },
        "timeout_ms": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "model"
      ]
    },
    "log_path": {
      "type": "string"
    },
    "log_disabled": {
      "type": "boolean"
    },
    "log_max_size": {
      "type": "integer"
    },
    "metrics_path": {
      "type": "string"
    },
    "metrics_disabled": {
      "type": "boolean"
    },
    "metrics_max_size": {
      "type": "integer"
    },
    "fallthrough_strategy": {
      "type": "string"
    },
    "allow": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "deny": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "environment": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "append_allow": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "append_deny": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "append_environment": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "JSON schema reference. Editors use this to enable validation; ccgate ignores it at runtime."
    }
  },
  "additionalProperties": false,
  "type": "object",
  "title": "ccgate claude configuration",
  "description": "Configuration schema for ccgate's claude PermissionRequest hook. See https://github.com/tak848/ccgate."
}
